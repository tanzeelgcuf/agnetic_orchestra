{
  "name": "agentic-dev-orchestra",
  "version": "0.1.0",
  "private": true,
  "description": "Orchestration platform coordinating specialized AI agents across the software development lifecycle",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter worker dev",
    "dev:web": "pnpm --filter web dev",
    "db:migrate": "pnpm --filter @orchestra/database migrate",
    "db:generate": "pnpm --filter @orchestra/database generate",
    "db:studio": "pnpm --filter @orchestra/database studio"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-orm": "^0.36.4",
    "eslint": "^9.16.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
