# --- Database ---
DATABASE_URL=postgres://orchestra:orchestra@localhost:5433/orchestra

# --- API ---
PORT=4100
# Bearer token for API auth. CHANGE BEFORE ANY REAL DEPLOYMENT.
ORCHESTRA_API_TOKEN=dev-token-change-me

# --- Worker ---
WORKER_POLL_INTERVAL_MS=500
WORKER_BATCH_SIZE=5

# --- Logging ---
LOG_LEVEL=info
# Comma-separated patterns to redact from logs
LOG_REDACT_PATHS=password,token,secret,authorization,apiKey
